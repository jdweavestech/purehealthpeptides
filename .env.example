# WooCommerce REST API (server-side only — never exposed to the client).
# Generate keys in WordPress: WooCommerce → Settings → Advanced → REST API.
# Read/write is not needed for this phase — Read is sufficient.
WOOCOMMERCE_STORE_URL=https://your-wp-site.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL (used for metadata / canonical URLs / sitemap).
NEXT_PUBLIC_SITE_URL=https://purehealthpeptides.com
